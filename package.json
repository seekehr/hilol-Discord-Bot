{
  "name": "factcheckerbot",
  "version": "2.0.0",
  "private": true,
  "description": "An AI-powered Discord bot that corrects objectively incorrect statements, drawing on statistics and Islamic sources with a Shi'a scholarly perspective",
  "author": "Seekehr",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts | pino-pretty --colorize --translateTime \"SYS:HH:MM:ss\" --ignore pid,hostname",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "commands:register": "tsx src/register-commands.ts",
    "config:check": "tsx src/check-config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run format:check && npm run build"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "gpt-tokenizer": "^4.1.0",
    "pino": "^10.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
