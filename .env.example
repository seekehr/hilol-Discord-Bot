# Secrets belong here or in your hosting platform's secret environment variables.
DISCORD_TOKEN=replace-with-bot-token
DISCORD_CLIENT_ID=replace-with-application-id
DISCORD_GUILD_ID=replace-with-your-server-id
GROQ_API_KEY=replace-with-groq-api-key
# Paths are relative to the working directory. Keep custom paths gitignored too.
CONFIG_PATH=./config/bot.json
STATE_PATH=./data/state.json
LOG_LEVEL=info
