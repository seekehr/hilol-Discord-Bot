{
  "ownerIds": [],
  "enabled": true,
  "promptFile": "factcheck.txt",
  "channels": {
    "include": [],
    "exclude": []
  },
  "replies": {
    "maxMessageChars": 1500,
    "userRequestsPerMinute": 6,
    "contextMessages": 4,
    "noLinkChannels": ["tts"]
  },
  "ai": {
    "model": "openai/gpt-oss-120b",
    "fallbackModel": "openai/gpt-oss-20b",
    "webSearch": true,
    "maxOutputTokens": 1500,
    "searchTokenAllowance": 3000,
    "timeoutMs": 60000,
    "maxRetries": 1,
    "openRouter": {
      "enabled": true,
      "model": "openrouter/free",
      "webSearchResults": 0
    }
  },
  "rateLimits": {
    "model": {
      "requestsPerMinute": 30,
      "requestsPerDay": 1000,
      "tokensPerMinute": 8000,
      "tokensPerDay": 200000
    },
    "fallbackModel": {
      "requestsPerMinute": 30,
      "requestsPerDay": 1000,
      "tokensPerMinute": 8000,
      "tokensPerDay": 200000
    }
  }
}
